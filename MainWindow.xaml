<Window x:Class="DetectAcUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DetectAcUI"
        mc:Ignorable="d"
        Title="sentinel"
        Width="680" Height="432"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- ==================== Кисти ==================== -->

        <!-- Затухающий красный акцент (левая линия карточки) -->
        <LinearGradientBrush x:Key="AccentFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6FF3B4B" Offset="0"/>
            <GradientStop Color="#00FF3B4B" Offset="1"/>
        </LinearGradientBrush>

        <!-- Мягкое красное свечение -->
        <RadialGradientBrush x:Key="GlowBrush">
            <GradientStop Color="#33FF3B4B" Offset="0"/>
            <GradientStop Color="#00FF3B4B" Offset="1"/>
        </RadialGradientBrush>

        <!-- ==================== Стили текста EULA ==================== -->

        <Style x:Key="IntroLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6A6D76"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FF4A5A"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#B9BCC4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>

        <!-- ==================== Тонкий скроллбар ==================== -->

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2E2E36" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Кнопка закрытия ==================== -->

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#9CA0A8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C1C22"/>
                                <Setter Property="Foreground" Value="#F2F2F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26262D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Кнопка "I Agree": серая до чекбокса, красная после ==================== -->
        <!-- Базовое состояние шаблона = выключенный вид; включение анимируется триггером IsEnabled -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#232329"/>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="lift"/>
                                    <ScaleTransform x:Name="bgScale"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF3B4B" BlurRadius="18" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                       Margin="{TemplateBinding Padding}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#6E6E78"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#FF3B4B" Duration="0:0:0.3"/>
                                            <ColorAnimation Storyboard.TargetName="txt"
                                                             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                             To="#FFFFFF" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.3" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#232329" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="txt"
                                                             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                             To="#6E6E78" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#FF5C6B" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="-1.5" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.3" Duration="0:0:0.28"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#FF3B4B" Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.965" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.965" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Кнопка "Decline" (тёмная) ==================== -->

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#141419"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#28282F"/>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="lift"/>
                                    <ScaleTransform x:Name="bgScale"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF3B4B" BlurRadius="14" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#1D1D23" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#40404A" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.25" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="-1.5" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#141419" Duration="0:0:0.26"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#28282F" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.965" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.965" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Карточка выбора языка ==================== -->

        <Style x:Key="LangCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Width="180" Height="86" CornerRadius="10"
                                BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#101014"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#22222A"/>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="lift"/>
                                    <ScaleTransform x:Name="bgScale"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF3B4B" BlurRadius="16" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="-2" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#141419" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#101014" Duration="0:0:0.26"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="local:MainWindow.IsCardSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#FF3B4B" Duration="0:0:0.22"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#170F13" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#22222A" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#101014" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="bgScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Чекбокс согласия ==================== -->

        <Style x:Key="AgreeCheckStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#17171B"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#2C2C33"/>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="boxGlow" Color="#FF3B4B" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                                <Path x:Name="check" Data="M3.2,8 L6.4,11.2 L12.8,4.4"
                                      Stretch="Uniform" Margin="3" Opacity="0"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="checkScale"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="box"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#FF3B4B" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="box"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#FF3B4B" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.4" To="1" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.7" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.4" To="1" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.7" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="boxGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="box"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#17171B" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="box"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#2C2C33" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="boxGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ==================== Каркас окна (тень + скруглённая рамка) ==================== -->
    <Grid x:Name="Root" Margin="24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTrans"/>
        </Grid.RenderTransform>

        <Border x:Name="ChromeBorder" CornerRadius="12"
                Background="#0B0B0E" BorderBrush="#1E1E24" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== Фон: дамп памяти (hex dump / code rain) ===== -->
                <Grid x:Name="HexLayer" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,630,382" RadiusX="11" RadiusY="11"/>
                    </Grid.Clip>
                    <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HexDrift"/>
                        </Grid.RenderTransform>
                        <StackPanel Margin="18,8,0,0">
                            <StackPanel x:Name="HexColumn"/>
                        </StackPanel>
                    </Grid>
                    <!-- Тонирование: удерживает фон в пределах 3-5% контраста -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#590B0B0E" Offset="0"/>
                                <GradientStop Color="#330B0B0E" Offset="0.5"/>
                                <GradientStop Color="#730B0B0E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ============ Заголовок ============ -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="#FF3B4B" Margin="0,1,9,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF3B4B" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0.25" Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="sentinel" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#F2F2F4" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#5A5D66" VerticalAlignment="Center" Margin="9,1,0,0"/>
                    </StackPanel>

                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                            Content="&#x2715;"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Click="Close_Click"/>
                </Grid>

                <!-- ============ Контент ============ -->
                <Grid Grid.Row="1">

                    <!-- ===== Экран 0: выбор языка (открывается после проверки ключа) ===== -->
                    <Grid x:Name="LangView" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="LangTrans"/>
                                <ScaleTransform x:Name="LangScale"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Width="360" Height="240" Fill="{StaticResource GlowBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.35" IsHitTestVisible="False"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel x:Name="LangHead" Opacity="0" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LangHeadTrans"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Выберите язык" FontSize="17" FontWeight="Bold"
                                           Foreground="#F4F4F6" HorizontalAlignment="Center"/>
                                <TextBlock Text="select language" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="#6A6D76" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="LangCards" Opacity="0" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,28,0,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LangCardsTrans"/>
                                </StackPanel.RenderTransform>
                                <Button x:Name="LangRuButton" Style="{StaticResource LangCardStyle}" Click="LangRu_Click">
                                    <StackPanel Margin="10,0">
                                        <TextBlock Text="RU" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#FF5C6B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Русский" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="#F2F2F4" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LangEnButton" Style="{StaticResource LangCardStyle}" Margin="14,0,0,0" Click="LangEn_Click">
                                    <StackPanel Margin="10,0">
                                        <TextBlock Text="EN" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#FF5C6B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="English" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="#F2F2F4" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button x:Name="ContinueButton" Content="Продолжить · Continue"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,30,0,0"
                                    HorizontalAlignment="Center" IsEnabled="False"
                                    Opacity="0" Click="Continue_Click">
                                <Button.RenderTransform>
                                    <TranslateTransform x:Name="ContinueTrans"/>
                                </Button.RenderTransform>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Экран 1: EULA ===== -->
                    <Grid x:Name="EulaView" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="EulaTrans"/>
                        </Grid.RenderTransform>

                        <!-- Мягкое красное свечение за шапкой -->
                        <Ellipse Width="380" Height="210" Fill="{StaticResource GlowBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-70,-50,0,0" Opacity="0.45" IsHitTestVisible="False"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка: щит, заголовок, бейдж -->
                            <Grid x:Name="HeaderRow" Grid.Row="0" Margin="22,4,22,14" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HeaderTrans"/>
                                </Grid.RenderTransform>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="10"
                                            Background="#150F12" BorderBrush="#362026" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF3B4B" BlurRadius="16" ShadowDepth="0" Opacity="0.18"/>
                                        </Border.Effect>
                                        <Viewbox Width="24" Height="24">
                                            <Grid Width="24" Height="24">
                                                <Path Data="M12 2.5 L19.5 5.2 V11 C19.5 15.9 16.3 19.6 12 21.3 C7.7 19.6 4.5 15.9 4.5 11 V5.2 Z"
                                                      Stroke="#FF3B4B" StrokeThickness="1.7" Fill="#251318"
                                                      StrokeLineJoin="Round"/>
                                                <Path Data="M8.4 11.8 L10.9 14.2 L15.6 9.4"
                                                      Stroke="#FF3B4B" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="EulaTitleText" Text="End-User License Agreement"
                                                   FontSize="16.5" FontWeight="Bold" Foreground="#F4F4F6"/>
                                        <TextBlock x:Name="EulaSubtitleText" Text="Review the terms &amp; privacy policy before continuing."
                                                   Margin="0,3,0,0" FontSize="12" Foreground="#8A8D96"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Бейдж REQUIRED -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="11" Background="#180F12"
                                        BorderBrush="#2E1C21" BorderThickness="1" Padding="11,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#FF3B4B" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FF3B4B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="RequiredText" Text="REQUIRED" FontFamily="Consolas" FontSize="10.5"
                                                   FontWeight="Bold" Foreground="#FF5C6B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Карточка с текстом лицензии (ручная прокрутка) -->
                            <Border x:Name="LicenseCard" Grid.Row="1" Margin="22,0,22,0" Opacity="0"
                                    Background="#101014" BorderBrush="#1F1F26" BorderThickness="1"
                                    CornerRadius="10">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="CardTrans"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Width="3" Fill="{StaticResource AccentFadeBrush}"
                                               Margin="1,12,0,12" Opacity="0.9"/>

                                    <ScrollViewer x:Name="LicenseScroll" Grid.Column="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="18,14,12,14" Focusable="False">
                                        <StackPanel x:Name="EulaBody" MaxWidth="540" HorizontalAlignment="Left"/>
                                    </ScrollViewer>

                                    <!-- Затемнение снизу карточки (намёк на продолжение текста) -->
                                    <Rectangle Grid.Column="1" Height="30" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00101014" Offset="0"/>
                                                <GradientStop Color="#B4101014" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- Подвал: чекбокс + кнопки -->
                            <Grid x:Name="FooterRow" Grid.Row="2" Margin="22,14,22,18" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="FooterTrans"/>
                                </Grid.RenderTransform>

                                <CheckBox x:Name="AgreeCheck" Style="{StaticResource AgreeCheckStyle}"
                                          VerticalAlignment="Center"
                                          Checked="AgreeCheck_Changed" Unchecked="AgreeCheck_Changed"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="DeclineButton" Content="Decline"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="Decline_Click"/>
                                    <Button x:Name="AgreeButton" Content="I Agree"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="10,0,0,0" IsEnabled="False"
                                            Click="Agree_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ===== Экран 1.5: Активация ключа ===== -->
                    <Grid x:Name="KeyView" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="KeyTrans"/>
                        </Grid.RenderTransform>

                        <Ellipse Width="360" Height="220" Fill="{StaticResource GlowBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.35" IsHitTestVisible="False"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                            <StackPanel x:Name="KeyHead" Opacity="0" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="KeyHeadTrans"/>
                                </StackPanel.RenderTransform>
                                <TextBlock x:Name="KeyTitle" Text="Активация доступа"
                                           FontSize="16.5" FontWeight="Bold" Foreground="#F4F4F6"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="KeySubtitle" Text="Введите ключ, выданный модератором"
                                           FontFamily="Consolas" FontSize="11.5" Foreground="#6A6D76"
                                           Margin="0,7,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border x:Name="KeyCard" Opacity="0" Background="#101014"
                                    BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="10"
                                    Padding="22,18" Margin="0,22,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KeyCardTrans"/>
                                </Border.RenderTransform>
                                <StackPanel>
                                    <Border Height="46" CornerRadius="8" Background="#141419"
                                            BorderBrush="#28282F" BorderThickness="1">
                                        <TextBox x:Name="KeyInput" Background="Transparent"
                                                 BorderThickness="0" Foreground="#E8E8EC" CaretBrush="#FF3B4B"
                                                 FontFamily="Consolas" FontSize="12"
                                                 VerticalContentAlignment="Center" Padding="12,0"
                                                 TextChanged="KeyInput_TextChanged"/>
                                    </Border>
                                    <TextBlock x:Name="KeyStatus" Text="" FontFamily="Consolas" FontSize="11"
                                               Foreground="#FF6B7A" Margin="2,9,0,0" MinHeight="15"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <Button x:Name="ActivateButton" Content="Активировать"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Center" Margin="0,12,0,0"
                                            IsEnabled="False" Click="ActivateKey_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="KeyHint" Opacity="0"
                                       Text="Ключ действует ограниченное время и привязывается к этому ПК"
                                       FontFamily="Consolas" FontSize="10.5" Foreground="#5A5D66"
                                       HorizontalAlignment="Center" Margin="0,16,0,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="KeyHintTrans"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Экран 2: Forensic scan ===== -->
                    <Grid x:Name="ScanView" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="ScanTrans"/>
                                <ScaleTransform x:Name="ScanScale"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Width="280" Height="280" Fill="{StaticResource GlowBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.4" IsHitTestVisible="False"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- Спиннер: вращение + дыхание -->
                            <Grid x:Name="SpinHost" Width="76" Height="76"
                                  HorizontalAlignment="Center" Margin="0,0,0,26"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SpinnerRotate"/>
                                        <ScaleTransform x:Name="SpinnerScale"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse Stroke="#1F1F26" StrokeThickness="2.5"/>
                                <Path Data="M 38,3.5 A 34.5,34.5 0 0 1 60.2,64.4"
                                      Stroke="#FF3B4B" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FF3B4B" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>

                            <!-- Галочка (после завершения) -->
                            <Grid x:Name="CheckHost" Width="76" Height="76"
                                  HorizontalAlignment="Center" Margin="0,0,0,26"
                                  Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="CheckScale"/>
                                </Grid.RenderTransform>
                                <Ellipse Stroke="#FF3B4B" StrokeThickness="1" Opacity="0.25" Margin="-10"/>
                                <Ellipse Stroke="#FF3B4B" StrokeThickness="2" Fill="#241318"/>
                                <Path Data="M23,38 L33,48 L52,27"
                                      Stroke="#FF3B4B" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FF3B4B" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>

                            <TextBlock x:Name="ScanTitle" Text="Forensic scan in progress"
                                       FontSize="17" FontWeight="SemiBold" Foreground="#F4F4F6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text=""
                                       FontFamily="Consolas" FontSize="12.5" Foreground="#7A7E88"
                                       Margin="0,9,0,0" HorizontalAlignment="Center"/>

                            <!-- Журнал завершённых этапов (реальное сканирование) -->
                            <TextBlock x:Name="ScanLogText" Text="" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="#5A5D66" TextAlignment="Center" Margin="0,16,0,0"
                                       LineHeight="16" Opacity="0"/>

                            <!-- Открытие отчёта после завершения -->
                            <Button x:Name="ReportButton" Content="Открыть отчёт"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"
                                    Click="ReportButton_Click"/>
                            <TextBlock x:Name="ReportHint" Text="Enter — открыть отчёт" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="#5A5D66" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Visibility="Collapsed"/>

                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ Оверлей: виньетка ============ -->
                <Grid Grid.RowSpan="2" IsHitTestVisible="False">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,630,382" RadiusX="11" RadiusY="11"/>
                    </Grid.Clip>
                    <Rectangle>
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#00000000" Offset="0.55"/>
                                <GradientStop Color="#00000000" Offset="0.78"/>
                                <GradientStop Color="#64000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
