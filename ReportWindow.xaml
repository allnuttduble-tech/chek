<Window x:Class="DetectAcUI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sentinel — report"
        Width="1000" Height="640"
        MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- ==================== Кисти ==================== -->

        <LinearGradientBrush x:Key="AccentFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6FF3B4B" Offset="0"/>
            <GradientStop Color="#00FF3B4B" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GlowBrush">
            <GradientStop Color="#33FF3B4B" Offset="0"/>
            <GradientStop Color="#00FF3B4B" Offset="1"/>
        </RadialGradientBrush>

        <!-- ==================== Тонкий скроллбар ==================== -->

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2E2E36" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Горизонтальный тонкий скроллбар таблицы -->
        <Style TargetType="ScrollBar" x:Key="HScrollStyle">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2E2E36" Margin="2,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Кнопка закрытия ==================== -->

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#9CA0A8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C1C22"/>
                                <Setter Property="Foreground" Value="#F2F2F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26262D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Кнопка «Закрыть» (тёмная) ==================== -->

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#141419"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#28282F"/>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="lift"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF3B4B" BlurRadius="14" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#1D1D23" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#40404A" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.25" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="-1.5" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                             To="#141419" Duration="0:0:0.26"/>
                                            <ColorAnimation Storyboard.TargetName="bg"
                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#28282F" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Таблица ==================== -->

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="hb" Background="Transparent" Padding="10,10,10,7"
                                BorderBrush="#17171D" BorderThickness="0,0,0,1">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Consolas"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#6A6D76"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hb" Property="Background" Value="#131318"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#B9BCC4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row" Background="Transparent" Padding="0,0,0,0" MinHeight="26">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#14141A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#191216"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B9BCC4"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root" Margin="24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTrans"/>
        </Grid.RenderTransform>

        <Border x:Name="ChromeBorder" CornerRadius="12"
                Background="#0B0B0E" BorderBrush="#1E1E24" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Заголовок ============ -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="#FF3B4B" Margin="0,1,9,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF3B4B" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="TitleText" Text="sentinel — отчёт" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#F2F2F4" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleMeta" Text="scan report" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#5A5D66" VerticalAlignment="Center" Margin="9,1,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="FullscreenButton" Style="{StaticResource CloseButtonStyle}"
                                Margin="0,0,2,0"
                                Click="FullscreenButton_Click">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Data="M1,5 V1 H5 M11,1 H15 V5 M15,11 V15 H11 M5,15 H1 V11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Content="&#x2715;"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Тело ============ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Разделы -->
                    <Border Background="#0D0D11" BorderBrush="#17171D" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,8,12">
                            <StackPanel x:Name="SidePanel"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Содержимое раздела -->
                    <Grid Grid.Column="1" Margin="18,14,18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="SectionTitle" Text="" FontSize="15.5" FontWeight="Bold"
                                           Foreground="#F4F4F6"/>
                                <TextBlock x:Name="SectionMeta" Text="" FontFamily="Consolas" FontSize="10.5"
                                           Foreground="#6A6D76" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Поиск -->
                            <Border x:Name="SearchBox" Width="240" Height="32" CornerRadius="8"
                                    Background="#141419" BorderBrush="#28282F" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"
                                          Data="M6.5,1 A5.5,5.5 0 1 0 6.5,12 A5.5,5.5 0 1 0 6.5,1 M10.6,10.6 L14.5,14.5"
                                          Stroke="#5A5D66" StrokeThickness="1.4" Width="14" Height="14"
                                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBox x:Name="SearchInput" Grid.Column="1" Background="Transparent"
                                             BorderThickness="0" Foreground="#E8E8EC" CaretBrush="#FF3B4B"
                                             FontSize="12.5" VerticalContentAlignment="Center"
                                             Margin="7,0,10,0" TextChanged="SearchInput_TextChanged"/>
                                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="поиск…"
                                               Foreground="#4E5158" FontSize="12.5" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0,10,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="SectionNote" Grid.Row="1" Text="" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#8A6E74" TextWrapping="Wrap" Margin="0,9,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Таблица -->
                        <Border Grid.Row="2" Margin="0,11,0,0" Background="#101014"
                                BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Rectangle Width="3" Fill="{StaticResource AccentFadeBrush}"
                                           HorizontalAlignment="Left" Margin="1,14,0,14" Opacity="0.9"/>
                                <ListView x:Name="Table" Margin="12,4,6,6"/>
                                <TextBlock x:Name="EmptyText" Text="нет данных" FontFamily="Consolas"
                                           FontSize="12" Foreground="#5A5D66"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ Подвал ============ -->
                <Grid Grid.Row="2" Margin="22,0,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FooterMeta" Grid.Row="0" Text="" FontFamily="Consolas" FontSize="10.5"
                               Foreground="#5A5D66" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="FooterHint" Text="Esc — закрыть" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#5A5D66" VerticalAlignment="Center"/>
                        <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" Click="Close_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
